{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "imageRepository",
    "api",
    "buildWorker",
    "deployWorker",
    "migration",
    "database"
  ],
  "properties": {
    "imageRepository": {
      "type": "string",
      "pattern": "^([0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/iris/was)?$"
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "serviceAccountName": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "port": {
          "type": "integer"
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "groupName": {
              "type": "string"
            }
          }
        },
        "allowedCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9.]+/[0-9]+$"
          }
        }
      }
    },
    "buildWorker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "serviceAccountName": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "deployWorker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "serviceAccountName": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "argocd": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "egressCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9.]+/[0-9]+$"
          }
        },
        "port": {
          "type": "integer"
        }
      }
    }
  },
  "if": {
    "anyOf": [
      {
        "properties": {
          "api": {
            "properties": {
              "digest": {
                "minLength": 1
              }
            },
            "required": [
              "digest"
            ]
          }
        },
        "required": [
          "api"
        ]
      },
      {
        "properties": {
          "buildWorker": {
            "properties": {
              "digest": {
                "minLength": 1
              }
            },
            "required": [
              "digest"
            ]
          }
        },
        "required": [
          "buildWorker"
        ]
      },
      {
        "properties": {
          "deployWorker": {
            "properties": {
              "digest": {
                "minLength": 1
              }
            },
            "required": [
              "digest"
            ]
          }
        },
        "required": [
          "deployWorker"
        ]
      }
    ]
  },
  "then": {
    "properties": {
      "imageRepository": {
        "minLength": 1
      }
    }
  }
}
