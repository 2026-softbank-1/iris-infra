{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["server", "cluster", "directoryKey", "gatewayNamespace", "probe"],
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "clusterName", "tailnetFqdn", "apiPort", "appsPort"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9]{7}$" },
        "clusterName": { "type": "string", "pattern": "^onprem-[a-z][a-z0-9]{7}$" },
        "tailnetFqdn": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^iris-[a-z][a-z0-9]{7}\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.ts\\.net$"
        },
        "apiPort": { "type": "integer", "const": 6443 },
        "appsPort": { "type": "integer", "const": 80 }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caData", "encryptedConfig"],
      "properties": {
        "caData": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
        "encryptedConfig": { "type": "string", "minLength": 16, "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
      }
    },
    "directoryKey": { "type": "string", "pattern": "^[a-z][a-z0-9]{7}$" },
    "gatewayNamespace": { "const": "onprem-gateway" },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoURL", "targetRevision", "project"],
      "properties": {
        "repoURL": {
          "enum": [
            "https://github.com/2026-softbank-1/iris-infra.git",
            "git@github.com:2026-softbank-1/iris-infra.git"
          ]
        },
        "targetRevision": { "type": "string", "pattern": "^(main|[0-9a-f]{40}|[0-9a-f]{64})$" },
        "project": { "const": "iris-onprem-probe" }
      }
    }
  }
}
