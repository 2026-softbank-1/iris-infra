{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repoURL",
    "revision",
    "targets",
    "services",
    "platform"
  ],
  "properties": {
    "repoURL": {
      "enum": [
        "https://github.com/2026-softbank-1/iris-infra.git",
        "git@github.com:2026-softbank-1/iris-infra.git"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^(main|[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "management",
        "workload"
      ],
      "properties": {
        "management": {
          "type": "object",
          "required": [
            "endpoint",
            "name",
            "region",
            "vpc_id"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^https://[A-Za-z0-9.-]+\\.eks\\.amazonaws\\.com$"
            },
            "name": {
              "type": "string"
            },
            "region": {
              "const": "ap-northeast-2"
            },
            "vpc_id": {
              "type": "string",
              "pattern": "^vpc-[0-9a-f]+$"
            }
          }
        },
        "workload": {
          "type": "object",
          "required": [
            "endpoint",
            "name",
            "region",
            "vpc_id"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^https://[A-Za-z0-9.-]+\\.eks\\.amazonaws\\.com$"
            },
            "name": {
              "type": "string"
            },
            "region": {
              "const": "ap-northeast-2"
            },
            "vpc_id": {
              "type": "string",
              "pattern": "^vpc-[0-9a-f]+$"
            }
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repoURL",
        "revision",
        "chartRevision"
      ],
      "properties": {
        "repoURL": {
          "enum": [
            "https://github.com/2026-softbank-1/iris-gitops-environments.git",
            "git@github.com:2026-softbank-1/iris-gitops-environments.git"
          ]
        },
        "revision": {
          "const": "main"
        },
        "chartRevision": {
          "type": "string",
          "pattern": "^iris-service-[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "onprem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "server": {"type": "string", "pattern": "^https://"},
            "ingressClassName": {"type": "string", "minLength": 1},
            "egressDeniedCidrs": {"type": "array", "items": {"type": "string"}}
          },
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {"required": ["server", "ingressClassName", "egressDeniedCidrs"]}
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "repos"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "repos": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "albTraffic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
