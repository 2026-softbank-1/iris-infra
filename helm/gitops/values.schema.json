{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repoURL",
    "revision",
    "targets",
    "services",
    "platform"
  ],
  "properties": {
    "repoURL": {
      "enum": [
        "https://github.com/2026-softbank-1/iris-infra.git",
        "git@github.com:2026-softbank-1/iris-infra.git"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^(main|[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "management",
        "workload"
      ],
      "properties": {
        "management": {
          "type": "object",
          "required": [
            "endpoint",
            "name",
            "region",
            "vpc_id"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^https://[A-Za-z0-9.-]+\\.eks\\.amazonaws\\.com$"
            },
            "name": {
              "type": "string"
            },
            "region": {
              "const": "ap-northeast-2"
            },
            "vpc_id": {
              "type": "string",
              "pattern": "^vpc-[0-9a-f]+$"
            }
          }
        },
        "workload": {
          "type": "object",
          "required": [
            "endpoint",
            "name",
            "region",
            "vpc_id"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^https://[A-Za-z0-9.-]+\\.eks\\.amazonaws\\.com$"
            },
            "name": {
              "type": "string"
            },
            "region": {
              "const": "ap-northeast-2"
            },
            "vpc_id": {
              "type": "string",
              "pattern": "^vpc-[0-9a-f]+$"
            }
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repoURL",
        "revision",
        "chartRevision"
      ],
      "properties": {
        "repoURL": {
          "enum": [
            "https://github.com/2026-softbank-1/iris-gitops-environments.git",
            "git@github.com:2026-softbank-1/iris-gitops-environments.git"
          ]
        },
        "revision": {
          "const": "main"
        },
        "chartRevision": {
          "type": "string",
          "pattern": "^iris-service-[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "onprem": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "chartRevision": {
              "type": "string",
              "pattern": "^iris-service-[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "server": {
              "type": "string",
              "pattern": "^https://"
            },
            "ingressClassName": {
              "type": "string",
              "minLength": 1
            },
            "egressDeniedCidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "chartRevision",
              "server",
              "ingressClassName",
              "egressDeniedCidrs"
            ]
          }
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "repos"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "repos": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "onpremServers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "chartRevision": {
          "type": "string",
          "pattern": "^iris-service-[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "ingressClassName": {
          "type": "string",
          "minLength": 1
        },
        "egressDeniedCidrs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "chartRevision",
          "ingressClassName",
          "egressDeniedCidrs"
        ]
      }
    },
    "onpremGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "onpremAuthRenewal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "albTraffic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "gcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^https://[a-z0-9.-]+\\.gke\\.goog$"
        },
        "baseDomain": {
          "type": "string",
          "minLength": 1
        },
        "addressName": {
          "type": "string",
          "minLength": 1
        },
        "certificateMap": {
          "type": "string",
          "minLength": 1
        },
        "deniedCidrs": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "chartRevision": {
          "const": "iris-service-0.10.0"
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string"
            },
            "serviceAccountEmail": {
              "type": "string"
            },
            "serviceAccountId": {
              "type": "string"
            },
            "awsAccountId": {
              "type": "string"
            },
            "roleArn": {
              "type": "string"
            },
            "audience": {
              "type": "string"
            },
            "kubeApiCidr": {
              "type": "string"
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "endpoint",
          "baseDomain",
          "addressName",
          "certificateMap",
          "deniedCidrs",
          "chartRevision",
          "credentials"
        ]
      }
    }
  }
}
