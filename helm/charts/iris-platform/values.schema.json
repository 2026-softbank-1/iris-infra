{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "was",
    "database",
    "api",
    "buildWorker",
    "deployWorker",
    "errorAgent",
    "migration",
    "network",
    "awsRegion"
  ],
  "properties": {
    "was": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "logLevel"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.ap-northeast-2\\.amazonaws\\.com/iris/was$"
            }
          }
        },
        "logLevel": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR"
          ]
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret",
        "urlKey",
        "caConfigMap",
        "caKey"
      ],
      "properties": {
        "secret": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "urlKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "caConfigMap": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "caKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "host",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        }
      }
    },
    "buildWorker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "codebuildProject",
        "artifactBucket",
        "githubSecret",
        "resources",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "codebuildProject": {
          "type": "string",
          "minLength": 1
        },
        "artifactBucket": {
          "type": "string",
          "minLength": 1
        },
        "githubSecret": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 120,
          "maximum": 3600
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        }
      }
    },
    "deployWorker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "baseDomain",
        "gitopsRepository",
        "githubSecret",
        "argocdUrl",
        "argocdSecret",
        "caConfigMap",
        "caKey",
        "resources",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "baseDomain": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        },
        "gitopsRepository": {
          "const": "2026-softbank-1/iris-gitops-environments"
        },
        "githubSecret": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "argocdUrl": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?/?$"
        },
        "argocdSecret": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "caConfigMap": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "caKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        }
      }
    },
    "errorAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "secret",
        "model",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            }
          }
        },
        "secret": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "image": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repository"
                ],
                "properties": {
                  "repository": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.ap-northeast-2\\.amazonaws\\.com/iris/error-check-agent$"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^(sha256:[a-f0-9]{64})?$"
                  }
                }
              },
              "secret": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources",
        "activeDeadlineSeconds",
        "backoffLimit"
      ],
      "properties": {
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "albSubnetCidrs",
        "rdsSubnetCidrs"
      ],
      "properties": {
        "albSubnetCidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/([1-9]|[12][0-9]|3[0-2])$"
          }
        },
        "rdsSubnetCidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/([1-9]|[12][0-9]|3[0-2])$"
          }
        }
      }
    },
    "awsRegion": {
      "const": "ap-northeast-2"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Iris platform deployment values"
}
