{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespaces",
    "applicationNamespace",
    "storageClass",
    "quota",
    "networkPolicy"
  ],
  "properties": {
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]+$"
      }
    },
    "applicationNamespace": {
      "type": "string",
      "enum": [
        "iris-platform",
        "iris-apps"
      ]
    },
    "storageClass": {
      "type": "object",
      "required": [
        "name",
        "reclaimPolicy"
      ],
      "properties": {
        "name": {
          "const": "gp3"
        },
        "reclaimPolicy": {
          "enum": [
            "Delete",
            "Retain"
          ]
        }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
