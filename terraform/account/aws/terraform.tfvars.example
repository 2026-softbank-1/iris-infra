aws_account_id = "000000000000"
aws_region     = "ap-northeast-2"
project        = "iris"
environment    = "dev"
github_oidc_subject_prefix = "repo:2026-softbank-1@334759803/iris-infra@1397906876"

# 대회 종료 후 실제 terraform.tfvars에 false를 저장하고 account apply로 회수합니다.
# 자동 만료되지 않습니다.
enable_temporary_admin_access = true

# 서비스 저장소의 실제 OIDC subject를 확인한 뒤 설정합니다.
# 매핑 예시: examples/github-actions/README.md (저장소 루트 기준)
github_ecr_publishers = {}

# foundation 및 CI의 cluster ARN scope와 일치시킵니다.
management_cluster_name = "iris-dev-management"
workload_cluster_name   = "iris-dev-workload"
