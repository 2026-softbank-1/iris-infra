{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "components",
    "database",
    "argocd"
  ],
  "properties": {
    "components": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,40}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/iris/[a-z0-9-]+$"
          },
          "digest": {
            "type": "string",
            "pattern": "^(sha256:[a-f0-9]{64})?$"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "migration": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "ingress": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "groupName"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "groupName": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "allowedCidrs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9.]+/[0-9]+$"
            }
          },
          "serviceAccountName": {
            "type": "string",
            "minLength": 1
          },
          "automountServiceAccountToken": {
            "type": "boolean"
          },
          "secretName": {
            "type": "string",
            "minLength": 1
          },
          "argocdEgress": {
            "type": "boolean"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "replicas": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "resources": {
            "type": "object"
          }
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object"
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "egressCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9.]+/[0-9]+$"
          }
        },
        "port": {
          "type": "integer"
        }
      }
    },
    "argocd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      }
    }
  }
}
